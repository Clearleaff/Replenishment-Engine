<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateErrorForMissingTargetingPacks>false</GenerateErrorForMissingTargetingPacks>
    <IsPublishable>false</IsPublishable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MSTEST0049</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <ProjectReference Include="..\..\src\EventBus\EventBus.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\src\IntegrationEventLogEF\IntegrationEventLogEF.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\src\Inventory.API\Inventory.API.csproj" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

</Project>
