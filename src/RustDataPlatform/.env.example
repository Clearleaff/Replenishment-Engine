# Environment configuration template for hybrid-orchestrator
# Copy this file to .env (which is gitignored) and add your secrets.
# NEVER commit .env or paste API keys in chat / git commits.

GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-20b"

# --- Tier-Agnostic Rate Limiter Configuration ---
# Set GROQ_TPM_BUDGET to the actual TPM limit shown in the Groq console for your account tier.
# Free Developer Tier: 8000
# Paid Pay-As-You-Go / Enterprise Tier: 500000+ (or as provisioned)
# When upgrading to a paid tier, update ONLY this value; no code or architectural changes are needed.
GROQ_TPM_BUDGET=8000
GROQ_TPM_ESTIMATE_PER_CALL=3500
LLM_QUEUE_MAX_DEPTH=200

CLICKHOUSE_URL="http://127.0.0.1:20255"
CLICKHOUSE_DATABASE="eshop_analytics"
CLICKHOUSE_USER="eshop"
CLICKHOUSE_PASSWORD="clickhousepass123"
HYBRID_ORCHESTRATOR_BIND="127.0.0.1:5005"
AMQP_URL="amqp://guest:guest@127.0.0.1:5672/%2f"
AMQP_PREFETCH=100
LLM_MAX_CONCURRENT=20
MACRO_CACHE_TTL_SECONDS=60
LLM_MAX_TOOL_ROUNDS=6
LLM_TOOL_TIMEOUT_SECONDS=5
LLM_MAX_IDENTICAL_TOOL_CALLS=1
HYBRID_ORCHESTRATOR_EXECUTION_MODE="LOG_ONLY"
